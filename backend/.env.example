# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/artisan_db
# Leave empty or set to sqlite:///./artisan_dev.db for zero-config local development
DATABASE_URL=sqlite:///./artisan_dev.db

# Payment Gateway Configuration
# Options: mock, razorpay, stripe
PAYMENT_PROVIDER=mock

# Razorpay Configuration (if PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_samplekey12345
RAZORPAY_KEY_SECRET=sample_secret_key_abcdef

# Stripe Configuration (if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_sample51N...
STRIPE_WEBHOOK_SECRET=whsec_sample...

# CORS Allowed Origins (Comma separated or * for dev)
CORS_ORIGINS=*

# Commission / Platform Fee Percentage (e.g. 5% platform fee for SHG operations)
PLATFORM_FEE_PERCENTAGE=5.0
